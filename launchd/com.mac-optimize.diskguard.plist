<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: install.sh substitutes __HOME__ and __PATH__ at install time. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac-optimize.diskguard</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/diskguard</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>10800</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/diskguard.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/diskguard.launchd.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
