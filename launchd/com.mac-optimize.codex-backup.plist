<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: install.sh substitutes __HOME__ and __PATH__ at install time. -->
<!-- Weekly cumulative backup of ~/.codex/sessions to the external drive.
     Runs --quiet, so it no-ops (exit 0) whenever the drive isn't mounted;
     it never deletes anything. Pruning stays a manual, reviewed step. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac-optimize.codex-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/codex-backup</string>
        <string>backup</string>
        <string>--quiet</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>11</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/codex-backup.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/codex-backup.launchd.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
