#!/usr/bin/env bash
# diskreport — "where is my disk going?" for an agent-heavy dev Mac.
# Read-only. Surfaces the top consumers plus the specific dirs that balloon
# during agent runs, so the answer is never "I don't know what's using it."
#
# Usage:
#   diskreport               fast fixed-bucket report (default, always run)
#   diskreport --scan [PATH] + a one-shot 'dust' scan of PATH (default: $HOME)
#                             to surface big single files/dirs the fixed
#                             buckets above don't look inside (e.g. a stray
#                             .zip buried in an app's Application Support).
#                             Requires 'dust' (brew install dust). Slower —
#                             walks the whole tree — so it's opt-in, not part
#                             of the default fast path.
#
# For open-ended interactive digging (not a report), use ncdu directly:
#   ncdu ~                    or any path — navigate, sort, delete in place.

set -uo pipefail
AS="$HOME/Library/Application Support"
SCAN=0; SCAN_PATH="$HOME"
for a in "${@:-}"; do
  case "$a" in
    --scan) SCAN=1 ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    "") : ;;
    *) SCAN_PATH="$a" ;;
  esac
done

hr() { printf '%s\n' "──────────────────────────────────────────────"; }
section() { printf '\n\033[1m%s\033[0m\n' "$1"; }

section "Volume"
df -h /System/Volumes/Data | awk 'NR==1 || /disk/'
snaps=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c com.apple)
echo "APFS local snapshots: ${snaps:-0}   (nonzero => 'invisible' disk; thin with: tmutil thinlocalsnapshots / )"

section "Top app state — ~/Library/Application Support"
du -h -d1 "$AS" 2>/dev/null | sort -rh | grep -v "	$AS\$" | head -10

section "Top caches — ~/Library/Caches"
du -h -d1 "$HOME/Library/Caches" 2>/dev/null | sort -rh | grep -v "Caches\$" | head -8

section "Dev / agent caches (these regrow — 'mac-reclaim' clears them)"
du -sh "$HOME/.npm" "$HOME/Library/pnpm" "$HOME/.cache" "$HOME/.bun" 2>/dev/null | sort -rh

# Enumerated, not hardcoded: the 2026-08 audit found ~30GB in dot-dirs
# (.codex/.gemini/.omp/.vscode) that a fixed list had never looked at.
section "Top hidden dot-dirs — ~/.*  (agent CLIs hoard session logs here)"
du -sh "$HOME"/.[!.]*/ 2>/dev/null | sort -rh | head -8

# OMP session store may live off-home via ~/.config/mac-optimize/omp-session-dir.conf
# or $OMP_SESSION_DIR/$PI_CODING_AGENT_SESSION_DIR; show it wherever it is.
omp_sess="${OMP_SESSION_DIR:-${PI_CODING_AGENT_SESSION_DIR:-}}"
if [ -z "$omp_sess" ] && [ -f "$HOME/.config/mac-optimize/omp-session-dir.conf" ]; then
  omp_sess=$(sed -n 's/^OMP_SESSION_DIR=//p' "$HOME/.config/mac-optimize/omp-session-dir.conf" | tail -1 | tr -d '"' | tr -d "'")
fi
if [ -n "$omp_sess" ] && [ -d "${omp_sess/#\~/$HOME}" ]; then
  printf '  %-6s  %s  (configured OMP session store)\n' \
    "$(du -sh "${omp_sess/#\~/$HOME}" 2>/dev/null | cut -f1)" "${omp_sess/#\~/$HOME}"
fi

section "REVIEW tier — big, but real state (prune via 'mac-reclaim --deep')"
for p in \
  "$AS/Code/User/workspaceStorage" \
  "$AS/Claude/vm_bundles" \
  "$AS/Claude/local-agent-mode-sessions" \
  "$HOME/.claude/projects" ; do
  [ -d "$p" ] && printf '  %-6s  %s\n' "$(du -sh "$p" 2>/dev/null | cut -f1)" "${p/#$HOME/~}"
done

section "Recent reclaims"
tail -n 5 "$HOME/Library/Logs/mac-reclaim.log" 2>/dev/null || echo "  (none yet — run 'mac-reclaim')"
hr

if [ "$SCAN" = 1 ]; then
  section "Deep scan — biggest items under ${SCAN_PATH/#$HOME/~} (dust)"
  if command -v dust >/dev/null 2>&1; then
    # -P when piped: dust's progress spinner writes \r frames to stderr, and
    # merging them into a captured report buries the actual size tree.
    if [ -t 1 ]; then dust -n 20 -d 3 "$SCAN_PATH" 2>&1
    else dust -P -n 20 -d 3 "$SCAN_PATH" 2>/dev/null; fi
  else
    echo "  'dust' not found — brew install dust (or: ncdu \"$SCAN_PATH\")"
  fi
  hr
fi
